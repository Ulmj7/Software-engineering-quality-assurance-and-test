{
  "info": {
    "name": "Lab05 — Даалгавар 5: нийтийн GET API",
    "description": "JSONPlaceholder GET /users: HTTP 200, массив, эхний хэрэглэгчийн нэр гэсэн гурван oracle. Локал collection-оос тусдаа тул үндсэн PASS/FAIL/DOWN тоонд орохгүй.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET users — статус, массив, Leanne Graham",
      "request": {
        "method": "GET",
        "header": [],
        "url": "https://jsonplaceholder.typicode.com/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Хариу массив байна\", function () {",
              "  pm.expect(pm.response.json()).to.be.an(\"array\");",
              "});",
              "pm.test(\"Эхний хэрэглэгчийн нэр Leanne Graham\", function () {",
              "  pm.expect(pm.response.json()[0].name).to.eql(\"Leanne Graham\");",
              "});"
            ]
          }
        }
      ],
      "response": []
    }
  ]
}
