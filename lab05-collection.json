{
  "info": {
    "name": "Lab05 — API систем тест: хичээлд бүртгүүлэх",
    "description": "F.CSA313. Бие даасан setup + POST + oracle. {{baseUrl}} collection variable. Newman 6-д нийцэх Postman Collection v2.1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "S01 — Идэвхтэй оюутан урьдач нөхцөл хангаж бүртгүүлэхэд OK",
      "description": "Даалгавар 1: B231234567 оюутан CS201 үзсэн; CS313 нь CS201 урьдачтай. POST дээр яг хоёр pm.test: статус ба result (registrationID тоо эсэхийг хоёр дахь oracle дотор шалгана).",
      "item": [
        {
          "name": "Setup — B231234567 идэвхтэй, CS201 үзсэн",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"result = OK\", function () {",
                  "  pm.expect(pm.response.json().result).to.eql(\"OK\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"active\",\n  \"coursesTaken\": [\n    \"CS201\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/students/B231234567"
          },
          "response": []
        },
        {
          "name": "Setup — CS313 урьдач CS201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"result = OK\", function () {",
                  "  pm.expect(pm.response.json().result).to.eql(\"OK\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prerequisites\": [\n    \"CS201\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/courses/CS313"
          },
          "response": []
        },
        {
          "name": "Бүртгүүлэх — HTTP 201 ба result OK",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"result = OK\", function () {",
                  "  pm.expect(pm.response.json().result).to.eql(\"OK\");",
                  "  pm.expect(pm.response.json().registrationID).to.be.a(\"number\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentID\": \"B231234567\",\n  \"courseID\": \"CS313\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/registrations"
          },
          "response": []
        }
      ]
    }
  ]
}
